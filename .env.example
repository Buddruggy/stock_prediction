# DeepSeek API Key —— 仅用于「自然语言解读」，不参与价格预测。
# 在 https://platform.deepseek.com 获取。留空则进入「纯模型模式」（无解读文本）。
DEEPSEEK_API_KEY=

# 可选覆盖项（一般无需修改）
# DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
# DEEPSEEK_MODEL=deepseek-chat
# PORT=8001
# DB_PATH=./backend/predictions.db
# HISTORY_DAYS=400      # 拉取的真实交易日数量（用于训练/回测）
# TRAIN_WINDOW=250      # walk-forward 滚动训练窗口
# PREDICT_HOUR=15
# PREDICT_MINUTE=10
